DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=havruta_app
DB_PASSWORD=change_me
DB_NAME=havruta_ai_tutor
# Railway에서는 아래처럼 MySQL 서비스의 MYSQL_URL을 DATABASE_URL로 참조합니다.
# DATABASE_URL=${{MySQL.MYSQL_URL}}
# REDIS_URL=${{Redis.REDIS_URL}}
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=none
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_OUTPUT_TOKENS=700
AI_REQUESTS_PER_MINUTE=12
AI_REQUESTS_PER_DAY=200
RAG_PROVIDER=auto
RAG_CURRICULUM_YEAR=2022
# 상대 경로는 저장소 루트 기준입니다. Railway에서는 볼륨의 절대 경로를 지정합니다.
CHROMA_DIR=chroma_db
CHROMA_COLLECTION=havruta_math_all
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_LOCAL_FILES_ONLY=true
RAG_MIN_SCORE=0.2
